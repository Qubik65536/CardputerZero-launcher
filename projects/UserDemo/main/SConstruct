import os

Import("env")
with open(env["PROJECT_TOOL_S"]) as f:
    exec(f.read())


SRCS = Glob("src/*.c*")
INCLUDE = [ADir("."), ADir("include")]
PRIVATE_INCLUDE = []
REQUIREMENTS = ["cp0_lvgl", "eventpp", "lvgl_component", "pthread"]
STATIC_LIB = []
DYNAMIC_LIB = []
DEFINITIONS = []
DEFINITIONS_PRIVATE = []
LDFLAGS = []
LINK_SEARCH_PATH = []
STATIC_FILES = []

SRCS += append_srcs_dir(ADir("ui"))
INCLUDE += ["ui"]

lvgl_component = list(
    filter(lambda x: x["target"] == "lvgl_component", env["COMPONENTS"])
)[0]
# CONFIG_USERDEMO_* keys are not declared in Kconfig, so they never reach the
# environment; key the SDL wiring on the LVGL SDL driver symbol instead.
if "CONFIG_V9_5_LV_USE_SDL" in os.environ:
    # pkg-config may emit -L / -Wl,-framework flags (Homebrew); only -l entries are libraries.
    sdl2_ldflags = pkg_config_ldflags("sdl2")
    REQUIREMENTS += [flag for flag in sdl2_ldflags if flag.startswith("-l")]
    LDFLAGS += [flag for flag in sdl2_ldflags if not flag.startswith("-l")]
    DEFINITIONS += pkg_config_cflags("sdl2")
    lvgl_component["DEFINITIONS"] += pkg_config_cflags("sdl2")
    lvgl_component["DEFINITIONS"] += ["-D_REENTRANT"]

if "CONFIG_USERDEMO_LINUX_CP0" in os.environ:
    REQUIREMENTS += ["input", "xkbcommon", "udev"]

env["COMPONENTS"].append(
    {
        "target": "M5CardputerZero-UserDemo",
        "SRCS": SRCS,
        "INCLUDE": INCLUDE,
        "PRIVATE_INCLUDE": PRIVATE_INCLUDE,
        "REQUIREMENTS": REQUIREMENTS,
        "STATIC_LIB": STATIC_LIB,
        "DYNAMIC_LIB": DYNAMIC_LIB,
        "DEFINITIONS": DEFINITIONS,
        "DEFINITIONS_PRIVATE": DEFINITIONS_PRIVATE,
        "LDFLAGS": LDFLAGS,
        "LINK_SEARCH_PATH": LINK_SEARCH_PATH,
        "STATIC_FILES": STATIC_FILES,
        "REGISTER": "project",
    }
)
