# Hello Cardputer - top-level build script (SCons + the M5Stack Linux SDK).
#
#   scons -j8                      # desktop simulator (macOS / Linux, SDL2)
#   CONFIG_DEFAULT_FILE=linux_x86_cross_cp0_config_defaults.mk scons -j8
#                                  # aarch64 binary for the CardputerZero
#
# The app must live at projects/<Name>/ in the launcher repository: the SDK and
# the shared components are found at ../../SDK and ../../ext_components.

from pathlib import Path
import os
import platform
import sys

local_path = Path(os.getcwd())
repo_root = local_path.parent.parent
sdk_path = repo_root / "SDK"
version = (repo_root / "ext_components" / "cp0_lvgl" / "sdk_version.txt").read_text(encoding="utf-8")
static_lib_path = sdk_path / "github_source" / f"static_lib_{version}"

# Pick a build profile (*_config_defaults.mk) unless the caller chose one.
if os.environ.get("CardputerZero", "") == "y":
    os.environ["CONFIG_DEFAULT_FILE"] = "linux_x86_cross_cp0_config_defaults.mk"
if os.environ.get("CONFIG_DEFAULT_FILE") is None:
    if platform.system() == "Darwin":
        os.environ["CONFIG_DEFAULT_FILE"] = "darwin_config_defaults.mk"
    elif platform.machine() in ("aarch64", "arm64"):
        os.environ["CONFIG_DEFAULT_FILE"] = "config_defaults.mk"  # building on the device itself
    else:
        os.environ["CONFIG_DEFAULT_FILE"] = "linux_x86_sdl2_config_defaults.mk"

# Make Homebrew cross toolchains visible to SCons on macOS.
sys.path.insert(0, str(repo_root / "scripts" / "scons"))
from cp0_host_toolchain import configure_host_toolchain
configure_host_toolchain(os.environ["CONFIG_DEFAULT_FILE"])

# The SDK only regenerates its Kconfig output when global_config.mk is missing, so
# forget the generated config whenever the selected profile (or its content) changes.
selected_config_path = Path(os.environ["CONFIG_DEFAULT_FILE"]).resolve()
selected_config = str(selected_config_path) + "\n" + selected_config_path.read_text()
config_dir = Path("build") / "config"
config_dir.mkdir(parents=True, exist_ok=True)
selection_stamp = config_dir / "selected-defaults.txt"
if not selection_stamp.exists() or selection_stamp.read_text() != selected_config:
    for generated_name in ("global_config.mk", "global_config.h", "lvgl_config.h"):
        (config_dir / generated_name).unlink(missing_ok=True)
    selection_stamp.write_text(selected_config)

# Cross builds link against the CardputerZero sysroot (downloaded on first use).
cross_build = "cross" in os.environ["CONFIG_DEFAULT_FILE"]
config_tmp_path = config_dir / "config_tmp.mk"
if cross_build:
    sysroot = static_lib_path.as_posix().replace('"', r'\"')
    config_tmp_content = f'CONFIG_TOOLCHAIN_SYSROOT="{sysroot}"\n'
    if not config_tmp_path.exists() or config_tmp_path.read_text() != config_tmp_content:
        config_tmp_path.write_text(config_tmp_content)
else:
    config_tmp_path.unlink(missing_ok=True)

os.environ["SDK_PATH"] = str(sdk_path)
os.environ["EXT_COMPONENTS_PATH"] = str(repo_root / "ext_components")

env = SConscript(str(sdk_path / "tools" / "scons" / "project.py"), variant_dir=os.getcwd(), duplicate=0)

if cross_build:
    tools = {}
    exec(Path(env["PROJECT_TOOL_S"]).read_text(), tools)
    tools["ensure_static_lib_version"](
        f"https://github.com/CardputerZero/launcher/releases/download/{version}/sdk_bsp.tar.gz",
        version,
        static_lib_path / "version",
    )
